{
  "name": "@qsweber/auth-kit",
  "version": "0.1.0",
  "description": "Shared Cognito/Amplify auth pages (login, signup, passkeys, etc.) for qsweber Next.js apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qsweber/auth-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "aws-amplify": "^6",
    "next": "^14 || ^15 || ^16",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "aws-amplify": "^6.22.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.3.0"
  }
}
